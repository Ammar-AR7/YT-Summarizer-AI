# =================================================================
# ENVIRONMENT VARIABLES CONFIGURATION / إعداد متغيرات البيئة
# =================================================================

# 1. GEMINI_API_KEY (Required / إجباري)
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Used for AI video summarization, transcript processing, and academic document refinement.
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. APP_URL (Required for Telegram Webhooks & Production / إجباري للبوت والنشر)
# The public domain URL where your application is deployed on Vercel or Cloud Run.
# Example: https://your-project-name.vercel.app
APP_URL="https://your-project-name.vercel.app"

# 3. TELEGRAM_BOT_TOKEN (Optional / اختياري لتكامل بوت تلغرام)
# Your Telegram Bot Token obtained from @BotFather on Telegram.
# Used for sending summaries, receiving video links, and interactive Telegram bot commands.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 4. OPTIONAL FIREBASE OVERRIDES (For custom Firebase Projects / اختيارية لمشروع فايربيس خاص)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
