# =================================================================
# ENVIRONMENT VARIABLES CONFIGURATION / إعداد متغيرات البيئة
# =================================================================

# 1. GEMINI_API_KEY (Required / إجباري)
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Used for AI video summarization, transcript processing, and academic document refinement.
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. APP_URL (Required for Telegram Webhooks & Production / إجباري للبوت والنشر)
# The public domain URL where your application is deployed on Vercel or Cloud Run.
# Example: https://your-project-name.vercel.app
APP_URL="https://your-project-name.vercel.app"

# 3. TELEGRAM_BOT_TOKEN (Optional / اختياري لتكامل بوت تلغرام)
# Your Telegram Bot Token obtained from @BotFather on Telegram.
# Used for sending summaries, receiving video links, and interactive Telegram bot commands.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 4. RENDER_BACKEND_URL (Required for Telegram Bot Webhook Relay / إجباري لعمل البوت)
# The public URL of your Render backend server.
# Vercel forwards Telegram webhook updates to this URL for processing.
# Example: https://yt-summarizer-ai-backend.onrender.com
RENDER_BACKEND_URL="https://your-backend.onrender.com"

# 5. FIREBASE CONFIGURATION (Optional - Fallbacks built-in / اختيارية لمشروعك الخاص في Firebase)
# If you don't provide these, the app will automatically connect to the default Firebase project.
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-app-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
# VITE_FIREBASE_APP_ID="1:123456789:web:abcdef..."
# VITE_FIREBASE_DATABASE_ID="(default)"
